{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/_/backend/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/index.ts",
      "routePrefix": "/_/backend"
    }
  }
}
